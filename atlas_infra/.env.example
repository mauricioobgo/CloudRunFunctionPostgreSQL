# Local/direct database URL for Atlas operations.
DB_URL=postgres://postgres:postgres@127.0.0.1:5432/app_db?search_path=app&sslmode=disable

# Atlas dev database URL used for normalization and linting.
DEV_URL=docker://postgres/16/dev?search_path=app

# Cloud SQL instance connection name (used in CI/CD proxy workflow).
INSTANCE_CONNECTION_NAME=testing-atlas-setup:us-east4:atlas-instance-test
